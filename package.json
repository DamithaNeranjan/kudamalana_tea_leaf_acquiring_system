{
  "name": "tea-leaf-acquiring-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/backend",
    "apps/desktop",
    "apps/web"
  ],
  "scripts": {
    "test": "node test/all.test.mjs",
    "backend": "node apps/backend/src/server.mjs",
    "desktop": "npm --workspace @tea/desktop run start",
    "desktop:sync": "npm --workspace @tea/desktop run sync-server",
    "web:dev": "npm --workspace @tea/web run dev",
    "web:build": "npm --workspace @tea/web run build"
  }
}
